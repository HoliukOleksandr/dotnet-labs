// dbdiagram.io (Проєкт №2: CatalogDb)
Table Products {
  Id bigint [pk, increment]
  Sku nvarchar(50) [unique, not null]
  Name nvarchar(200) [not null]
  Price decimal(18,2) [not null, note: 'CHECK Price > 0']
  IsActive bit
  IsDeleted bit
  RowVersion rowversion
}
Table ProductDetails {
  ProductId bigint [pk]
  Description nvarchar(max)
  Manufacturer nvarchar(150)
  WeightGrams int
  WarrantyMonths int
}
Table ProductImages {
  Id bigint [pk, increment]
  ProductId bigint [not null]
  Url nvarchar(500)
  SortOrder int
  IsMain bit
}
Table Categories {
  Id int [pk, increment]
  Name nvarchar(100) [unique]
  Slug nvarchar(120) [unique]
}
Table ProductCategories {
  ProductId bigint [pk]
  CategoryId int [pk]
  AddedAt datetime2 [note: 'власне поле зв’язку']
  IsPrimary bit
}
Ref: ProductDetails.ProductId - Products.Id         // 1:1
Ref: ProductImages.ProductId > Products.Id          // 1:N
Ref: ProductCategories.ProductId > Products.Id      // M:N
Ref: ProductCategories.CategoryId > Categories.Id   // M:N
