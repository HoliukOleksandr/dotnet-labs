// dbdiagram.io — вставте на https://dbdiagram.io/d  (Проєкт №1: OrdersDb)
Table Customers {
  Id bigint [pk, increment]
  Email nvarchar(256) [unique, not null]
  FullName nvarchar(200) [not null]
  CreatedAt datetime2
  IsDeleted bit [default: 0]
  RowVersion rowversion
}
Table Orders {
  Id bigint [pk, increment]
  CustomerId bigint [not null]
  Status nvarchar(30) [not null, default: 'Submitted', note: 'CHECK IN (Submitted, AwaitingValidation, StockConfirmed, Paid, Shipped, Cancelled)']
  OrderDate datetime2
  CreatedAt datetime2
  UpdatedAt datetime2
  IsDeleted bit
  RowVersion rowversion
  indexes {
    (CustomerId, Status) [name: 'IX_Orders_CustomerId_Status']
  }
}
Table OrderDetails {
  OrderId bigint [pk]
  ShippingAddress nvarchar(400) [not null]
  Comment nvarchar(1000)
}
Table Products {
  Id bigint [pk, note: 'локальна копія з CatalogDb, не IDENTITY']
  Name nvarchar(200)
  Price decimal(18,2)
  Stock int
}
Table OrderItems {
  OrderId bigint [pk]
  ProductId bigint [pk]
  ProductName nvarchar(200) [note: 'знімок']
  UnitPrice decimal(18,2) [note: 'знімок']
  Discount decimal(18,2)
  Units int
  indexes { ProductId [name: 'IX_OrderItems_ProductId'] }
}
Table OrderStatusHistory {
  Id bigint [pk, increment]
  OrderId bigint
  OldStatus nvarchar(30)
  NewStatus nvarchar(30)
  ChangedAt datetime2
  ChangedBy nvarchar(100)
}
Table PaymentRecords {
  Id bigint [pk, increment]
  OrderId bigint
  Amount decimal(18,2)
  Method nvarchar(30)
  PaidAt datetime2
}
Ref: Orders.CustomerId > Customers.Id          // 1:N
Ref: OrderDetails.OrderId - Orders.Id          // 1:1
Ref: OrderItems.OrderId > Orders.Id            // M:N (через OrderItems)
Ref: OrderItems.ProductId > Products.Id        // M:N (через OrderItems)
Ref: OrderStatusHistory.OrderId > Orders.Id    // 1:N
Ref: PaymentRecords.OrderId > Orders.Id        // 1:N
